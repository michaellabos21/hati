# Copy to .env, then restart the dev server (these values are read at build time).

# Demo mode: explore the app with sample data and no backend. Nothing is saved.
# Set to false (or remove) to use your Supabase project below.
EXPO_PUBLIC_DEMO_MODE=true

# Your Supabase project (Settings > API). Only the public anon key belongs here;
# never put the service_role key in the app.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Only for `npm run seed` (creates test accounts and verifies the project end to end).
# Server-side secret: never prefix it with EXPO_PUBLIC_ and never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# The public web address, used in invite links shared from the mobile app.
EXPO_PUBLIC_WEB_URL=
